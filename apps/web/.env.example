# Names only. Values live in Infisical (https://infiscal.digimuza.ai),
# one project per app, environments dev / staging / prod.
# Local dev:  infisical run --env dev -- pnpm dev
# `.env.local` (git-ignored) is written by `npx convex dev` with CONVEX_DEPLOYMENT.

# ===== Infisical path "/" : what the running app reads =====

# Public URLs. Not secret; read at runtime and handed to the browser.
# (In development, the NEXT_PUBLIC_CONVEX_* names written by `convex dev` also work.)
CONVEX_URL=
CONVEX_SITE_URL=
SITE_URL=

APP_ENV=

# WorkOS AuthKit (Next server). WORKOS_CLIENT_ID is also copied to Convex.
WORKOS_COOKIE_PASSWORD=
WORKOS_API_KEY=

# Copied to the Convex deployment by `pnpm deploy:convex` (plus APP_ENV, SITE_URL, WORKOS_CLIENT_ID).
WORKOS_CLIENT_ID=
SUPER_USER_EMAILS=
MAIL_FROM=
RESEND_API_KEY=
# AI assistant (optional), an OpenAI-compatible API: 9Router base URL, its API key, a model it exposes.
# Without OPENAI_API_KEY the assistant answers "not configured".
OPENAI_BASE_URL=
OPENAI_API_KEY=
AI_MODEL=
# Automations (optional). Extraction model (default AI_MODEL); the inbound email domain
# (Resend receiving domain); the Resend webhook signing secret (whsec_…); a full-access
# Resend key to read received emails (RESEND_API_KEY may be send-only).
AUTOMATIONS_AI_MODEL=
AUTOMATIONS_INBOUND_DOMAIN=
RESEND_WEBHOOK_SECRET=
RESEND_RECEIVING_API_KEY=
# Gavimas (ingest): encrypts the stored Resend webhook secret (openssl rand -base64 32).
INGEST_ENCRYPTION_KEY=
INGEST_RECEIVING_DOMAIN=
INGEST_TEST_FROM=

# ===== Infisical path "/ci" : CI only, never seen by the app =====

# Convex deploy credentials (one of the two)
CONVEX_DEPLOY_KEY=
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=
# docker.digimuza.ai push/pull
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
# Coolify API token and the UUID of <app>-staging or <app>-production
COOLIFY_TOKEN=
COOLIFY_APP_UUID=
COOLIFY_URL=
# Optional: move DIG-* issues to In Staging / Done
LINEAR_API_KEY=

# ===== Not in Infisical: the bootstrap =====
# Coolify app (runtime) and GitHub Actions (INFISCAL_CLIENT_ID / INFISCAL_SECRET as secrets).
INFISCAL_BASE_URL=
INFISCAL_CLIENT_ID=
INFISCAL_SECRET=
INFISCAL_PROJECT_ID=
INFISCAL_ENV=
INFISCAL_PATH=

{
  "name": "@digimuza/documents",
  "version": "0.1.0",
  "private": true,
  "description": "Documents business module for system-core apps: a labelled document archive (tags, correspondents, document types, custom fields, matching rules, full-text search, saved views) and e-signing (PDF templates, field placement, signing links, signed PDF with an audit certificate).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts",
    "./email": "./src/email.ts",
    "./matching": "./src/matching.ts",
    "./signing": "./src/signing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@digimuza/system-core": "0.8.0",
    "convex": "^1.49.0"
  },
  "devDependencies": {
    "@digimuza/system-core": "0.8.0",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "convex": "^1.49.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "8.3.7",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  }
}
